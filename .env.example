# Copy to .env and fill in. NEVER commit .env
AWS_REGION=us-east-1
AWS_PROFILE=grc-copilot

# Run scripts/check_bedrock.py to list the exact model IDs enabled in YOUR account.
# Use the cheapest model for the dev loop.
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Safety rails - see ADR-0003
MAX_AGENT_STEPS=8
MAX_TOKENS_PER_RUN=20000

# Embedding model for the vector index. Must match what the index was built
# with -- a query embedded by a different model lands in a different space and
# returns noise with no error. Changing this means rebuilding the index.
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# LangSmith telemetry. Keep this false.
#
# langsmith ships with langgraph and, when tracing is on, sends full prompts
# and full responses to LangChain's cloud. This product's prompts contain
# customer policy text by design, so turning this on would export customer data
# to a third party. If you ever need tracing, self-host it or use CloudWatch.
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
